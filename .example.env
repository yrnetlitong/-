APP_DEBUG = true

[APP]
DEFAULT_TIMEZONE = Asia/Shanghai

[DATABASE]
TYPE = mysql
HOSTNAME = 127.0.0.1
DATABASE = test
USERNAME = username
PASSWORD = password
PREFIX = think_
HOSTPORT = 3306
CHARSET = utf8mb4
DEBUG = true

[LANG]
default_lang = zh-cn

[CODE_GENERATOR]
author = admin

[JWT]
secret = your-jwt-secret-key-here-change-in-production
expire = 7200

[CACHE]
driver = file
host = 127.0.0.1
port = 6379
password = 
select = 0
expire = 3600
prefix = EVTP6_

[LOG]
channel = file
level = info
