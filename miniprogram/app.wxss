page{background:#FBF6EF;color:#49372D;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:28rpx;line-height:1.65}view,text,input,textarea,button{box-sizing:border-box}button{font-size:28rpx;border-radius:24rpx;line-height:1.4;padding:25rpx 28rpx;font-weight:600}button::after{border:0}button[disabled]{opacity:.5}button.primary{background:#B6532D;color:white}button.secondary{background:#F5E8D9;color:#83452C}button.ghost{background:transparent;color:#945030;border:1rpx solid #DFCBBA}button.danger{background:#FBE4DF;color:#A03D32}.page{padding:32rpx 32rpx calc(44rpx + env(safe-area-inset-bottom))}.eyebrow{font-size:22rpx;color:#9B613B;letter-spacing:4rpx;font-weight:600}.title{font-size:46rpx;line-height:1.35;font-weight:700;letter-spacing:-1rpx;margin:12rpx 0 18rpx}.subtitle,.muted{color:#806E60;font-size:25rpx}.hero{background:#F3DFC5;border-radius:36rpx;position:relative;padding:40rpx;overflow:hidden;min-height:290rpx}.hero .title{max-width:420rpx}.hero-image{position:absolute;width:245rpx;height:245rpx;right:-16rpx;bottom:-15rpx}.hero-copy{max-width:410rpx;position:relative;z-index:1}.section{display:flex;justify-content:space-between;align-items:center;margin:38rpx 0 22rpx}.section-title{font-size:33rpx;font-weight:650}.link{color:#A34D2A;font-size:26rpx;padding:12rpx 0 12rpx 16rpx}.card{background:#FFFDF9;border:1rpx solid #EDDFD0;border-radius:28rpx;padding:28rpx;margin-bottom:22rpx}.row{display:flex;align-items:center;gap:22rpx}.between{justify-content:space-between}.grow{flex:1;min-width:0}.name{font-size:32rpx;font-weight:650;word-break:break-all}.avatar{width:112rpx;height:112rpx;border-radius:28rpx;background:#F4DFC5;flex-shrink:0}.small-avatar{width:76rpx;height:76rpx;border-radius:50%;background:#F4DFC5}.tag{display:inline-block;background:#F5E8D8;color:#835334;padding:5rpx 16rpx;border-radius:12rpx;font-size:22rpx;margin:10rpx 12rpx 0 0}.tag.green{background:#E7EDDD;color:#4D6537}.tag.red{background:#FBE4DF;color:#9B3829}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20rpx}.quick{padding:28rpx;border-radius:26rpx;background:#FFFDF9;border:1rpx solid #EDDFD0}.quick image{height:52rpx;width:52rpx;margin-bottom:12rpx}.quick text{display:block}.quick .muted{font-size:23rpx;margin-top:6rpx}.empty{padding:50rpx 25rpx;text-align:center;color:#806E60}.empty image{width:160rpx;height:160rpx;display:block;margin:0 auto 20rpx}.empty button{margin:24rpx auto 0}.error{background:#FBE4DF;border-radius:20rpx;padding:24rpx;color:#9B3829;margin:20rpx 0}.error button{margin-top:16rpx}.loading{text-align:center;padding:28rpx;color:#806E60}.chips{display:flex;gap:16rpx;white-space:nowrap;margin:24rpx 0;overflow-x:auto}.chip{display:inline-block;padding:16rpx 26rpx;border-radius:40rpx;background:#FFFDF9;border:1rpx solid #EDDFD0;font-size:25rpx}.chip.active{background:#B6532D;color:#fff;border-color:#B6532D}.actions{display:flex;gap:16rpx;flex-wrap:wrap;margin-top:24rpx}.actions button{flex:1;min-width:150rpx;padding:22rpx 14rpx}.field{margin:0 0 30rpx}.label{display:block;font-weight:600;margin-bottom:14rpx}.required{color:#B6532D}.input,input,textarea,.picker{background:#F8F1E8;border:1rpx solid #E4D3C0;border-radius:18rpx;padding:22rpx;width:100%;min-height:88rpx;font-size:28rpx;color:#49372D}textarea{height:190rpx}.hint{font-size:23rpx;color:#806E60;margin-top:10rpx}.photo-grid{display:flex;gap:16rpx;flex-wrap:wrap}.photo-wrap{position:relative}.photo{width:174rpx;height:174rpx;border-radius:22rpx}.photo-delete{position:absolute;right:0;top:0;background:#49372D;color:white;padding:10rpx 18rpx;border-radius:0 20rpx 0 20rpx;font-size:24rpx}.divider{height:1rpx;background:#EDDFD0;margin:24rpx 0}.detail-row{display:flex;justify-content:space-between;gap:24rpx;padding:16rpx 0;align-items:flex-start}.detail-row .muted{flex-shrink:0}.detail-row .value{text-align:right;word-break:break-all;white-space:pre-wrap}.cover{width:100%;height:350rpx;border-radius:28rpx;background:#F3DFC5}.stat{font-size:43rpx;font-weight:700;display:block}.nav-row{padding:28rpx 0;border-bottom:1rpx solid #EDDFD0;display:flex;justify-content:space-between}.nav-row:last-child{border:0}.note{white-space:pre-wrap;word-break:break-word}.bottom-space{height:24rpx}
