<import src="../../templates/state.wxml"/><view class="page"><template is="state" data="{{loading,error}}"/><block wx:if="{{pet}}"><view class="hero row"><image class="avatar" style="width:160rpx;height:160rpx" src="{{pet.cover}}" mode="aspectFill"/><view><view class="eyebrow">MY LITTLE COMPANION</view><view class="title">{{pet.name}}</view><text class="tag">{{pet.typeText}}</text><text class="tag">{{pet.genderText}}</text></view></view><view class="actions"><button class="primary" bindtap="record">＋ 记录日常</button><button class="secondary" bindtap="remind">养护提醒</button></view><view class="section"><text class="section-title">认识 {{pet.name}}</text><text class="link" bindtap="edit">编辑资料 ›</text></view><view class="card"><view class="detail-row"><text class="muted">品种 / 毛色</text><text>{{pet.breed || '-'}} / {{pet.color || '-'}}</text></view><view class="detail-row"><text class="muted">生日 / 体重</text><text>{{pet.birthday || '-'}} / {{pet.weight}} kg</text></view><view class="detail-row"><text class="muted">绝育情况</text><text>{{pet.neuteredText}}</text></view><view class="detail-row"><text class="muted">疫苗情况</text><text class="value">{{pet.vaccination || '-'}}</text></view><view class="detail-row"><text class="muted">性格特点</text><text class="value">{{pet.character_note || '-'}}</text></view><view wx:if="{{pet.note}}" class="note muted">{{pet.note}}</view><view class="photo-grid"><image wx:for="{{pet.images}}" wx:key="*this" class="photo" src="{{item}}" mode="aspectFill" data-urls="{{pet.images}}" data-src="{{item}}" bindtap="preview"/></view></view><view class="section"><text class="section-title">成长时间轴</text><text class="muted">{{total}} 条日常</text></view><scroll-view scroll-x><view class="chips"><text class="chip {{type===''?'active':''}}" data-type="" bindtap="filter">全部</text><text wx:for="{{recordTypes}}" wx:key="code" class="chip {{type===item.code?'active':''}}" data-type="{{item.code}}" bindtap="filter">{{item.name}}</text></view></scroll-view><view wx:for="{{list}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="detail"><text class="tag">{{item.typeText}}</text><text class="muted">{{item.timeText}}</text><view class="name" style="margin-top:14rpx">{{item.product}}</view><view class="muted">{{item.amount || item.method || '查看记录详情'}} ›</view></view><view wx:if="{{!list.length && !loading}}" class="empty">从今天开始，记下第一件小事。</view><button class="ghost" bindtap="remove">删除宠物档案</button></block></view>
