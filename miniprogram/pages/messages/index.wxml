<import src="../../templates/state.wxml"/><view class="page"><view class="eyebrow">A NOTE FOR YOU</view><view class="title">给你的小消息</view><template is="state" data="{{loading,error}}"/><view wx:for="{{list}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="detail"><view class="row between"><text class="name">{{item.title}}</text><text wx:if="{{!item.pet_read_at}}" class="tag">未读</text></view><view class="note" style="margin:18rpx 0">{{item.content}}</view><text class="muted">{{item.timeText}} ›</text></view><view wx:if="{{!list.length && !loading}}" class="empty">暂时没有新消息，安心享受陪伴吧。</view></view>
