<import src="../../templates/state.wxml"/><view class="page"><view class="eyebrow">MY DOUZHI</view><view class="title">把爱，放在日常里。</view><template is="state" data="{{loading,error}}"/><view class="card"><view wx:if="{{user}}" class="row" bindtap="edit"><image class="avatar" src="{{user.avatar || '/images/pet.png'}}" mode="aspectFill"/><view class="grow"><view class="name">{{user.nickname}}</view><view class="muted">编辑个人资料 ›</view></view></view><view wx:else><view class="name">你好，豆知的新朋友</view><view class="muted" style="margin:16rpx 0">登录后，照顾好属于你的小世界。</view><button class="primary" bindtap="login">微信登录</button></view><view wx:if="{{user}}" class="row between" style="margin-top:30rpx;text-align:center"><view data-path="pets" bindtap="go"><text class="stat">{{user.pet_count}}</text><text class="muted">我的宠物</text></view><view data-path="reminders/index" bindtap="go"><text class="stat">{{user.reminder_count}}</text><text class="muted">养护提醒</text></view><view data-path="submissions/index" bindtap="go"><text class="stat">{{user.place_count}}</text><text class="muted">我的投稿</text></view></view></view><view class="card"><view class="nav-row" data-path="pets" bindtap="go"><text>我的宠物</text><text>›</text></view><view class="nav-row" data-path="reminders/index" bindtap="go"><text>我的提醒</text><text>›</text></view><view class="nav-row" data-path="submissions/index" bindtap="go"><text>我的投稿</text><text>›</text></view><view class="nav-row" data-path="messages/index" bindtap="go"><text>消息通知</text><text>›</text></view></view><view class="card"><view class="nav-row" data-path="info/index?kind=about" bindtap="go"><text>关于豆知</text><text>›</text></view><view class="nav-row" data-path="info/index?kind=privacy" bindtap="go"><text>隐私与授权设置</text><text>›</text></view></view><button wx:if="{{user}}" class="ghost" bindtap="logout">退出登录</button><view class="empty">豆知宠物 · 陪伴有迹可循</view></view>

<view wx:if="{{editing}}" class="profile-mask" catchtouchmove="stopScroll">
  <view class="profile-dialog">
    <view class="profile-dialog-title">编辑个人资料</view>
    <view class="profile-dialog-hint">换个头像，让豆知认识你</view>
    <button class="avatar-picker" open-type="chooseAvatar" bindchooseavatar="avatar" disabled="{{saving}}"><image src="{{avatar || '/images/pet.png'}}" mode="aspectFill"/><view>更换头像</view></button>
    <view class="profile-label">昵称</view>
    <input class="profile-input" type="nickname" value="{{nickname}}" bindinput="input" bindblur="input" maxlength="40" placeholder="请输入昵称" adjust-position="{{true}}" cursor-spacing="100" disabled="{{saving}}"/>
    <view class="profile-buttons"><button class="secondary" bindtap="edit" disabled="{{saving}}">取消</button><button class="primary" bindtap="save" loading="{{saving}}" disabled="{{saving}}">保存</button></view>
  </view>
</view>
