.profile-mask{position:fixed;inset:0;background:rgba(42,32,25,.45);z-index:1000;display:flex;align-items:center;justify-content:center;padding:32rpx;box-sizing:border-box}.profile-dialog{width:100%;max-width:620rpx;max-height:80vh;overflow-y:auto;box-sizing:border-box;background:#fffdf9;border-radius:28rpx;padding:40rpx 32rpx;padding-bottom:calc(32rpx + env(safe-area-inset-bottom))}.profile-dialog-title{text-align:center;font-size:36rpx;font-weight:600}.profile-dialog-hint{text-align:center;font-size:24rpx;color:#9a8473;margin:12rpx 0 28rpx}.avatar-picker{width:160rpx;margin:0 auto 32rpx;padding:0;background:transparent;line-height:1.5;border-radius:0;font-size:24rpx;color:#b6532d}.avatar-picker::after{border:0}.avatar-picker image{display:block;width:136rpx;height:136rpx;margin:0 auto 12rpx;border-radius:50%;background:#f6ede3}.profile-label{font-size:28rpx;margin-bottom:14rpx}.profile-input{height:88rpx;min-height:88rpx;padding:0 24rpx;box-sizing:border-box;border:1rpx solid #e5d8ca;background:#fff;border-radius:14rpx;font-size:30rpx}.profile-buttons{display:flex;gap:20rpx;margin-top:36rpx}.profile-buttons button{flex:1;margin:0;font-size:28rpx}
