<import src="../../templates/state.wxml"/><view class="page"><template is="state" data="{{loading,error}}"/><block wx:if="{{item}}"><view class="eyebrow">LITTLE MOMENTS</view><view class="title">{{item.typeText}}记录</view><view class="subtitle">{{item.timeText}}</view><view class="card" style="margin-top:30rpx"><block wx:if="{{item.field_values.length}}"><view wx:for="{{item.field_values}}" wx:for-item="field" wx:key="key" class="detail-row"><text class="muted">{{field.label}}</text><text class="value">{{field.value || '-'}}</text></view></block><block wx:else><view class="detail-row"><text class="muted">食物 / 用品 / 药品</text><text class="value">{{item.product}}</text></view><view class="detail-row"><text class="muted">数量 / 规格</text><text class="value">{{item.amount || '-'}}</text></view><view class="detail-row"><text class="muted">方式</text><text class="value">{{item.method || '-'}}</text></view></block><view class="detail-row"><text class="muted">下次时间</text><text class="value">{{item.nextText}}</text></view><view class="divider"/><view class="note">{{item.note || '没有补充说明'}}</view><view class="photo-grid" style="margin-top:24rpx"><image wx:for="{{item.images}}" wx:for-item="photo" wx:key="*this" class="photo" src="{{photo}}" mode="aspectFill" data-urls="{{item.images}}" data-src="{{photo}}" bindtap="preview"/></view></view><button class="ghost" bindtap="remove">删除记录</button></block></view>
