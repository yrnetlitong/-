<import src="../../templates/state.wxml"/><view class="page"><view class="eyebrow">A LITTLE MORE LOVE</view><view class="title">{{title}}</view><view class="subtitle">认真记录，让照顾更从容。</view><template is="state" data="{{loading,error}}"/><block wx:if="{{!loading && !error}}"><view class="card" style="margin-top:30rpx"><view wx:if="{{kind==='record' || kind==='reminder'}}" class="field"><text class="label">属于哪位小可爱 <text class="required">*</text></text><picker wx:if="{{pets.length}}" range="{{pets}}" range-key="name" value="{{petIndex}}" bindchange="choosePet"><view class="picker">{{pets[petIndex].name}} ›</view></picker><button wx:else class="secondary" bindtap="addPet">先添加一只宠物</button></view><view wx:if="{{kind==='place'}}" class="field"><button class="secondary" bindtap="location">{{form.latitude !== undefined ? '重新选择地图位置' : '在地图上选择位置'}}</button><view wx:if="{{form.latitude !== undefined}}" class="hint">已选坐标：{{form.latitude}}, {{form.longitude}}</view></view><block wx:for="{{fields}}" wx:key="key"><view wx:if="{{item.key !== 'interval_days' || form.cycle==='custom'}}" class="field"><text class="label">{{item.label}} <text wx:if="{{item.required}}" class="required">*</text></text><picker wx:if="{{item.kind==='select'}}" range="{{item.options}}" range-key="label" value="{{item.selected}}" data-key="{{item.key}}" bindchange="choose"><view class="picker">{{item.options[item.selected].label}} ›</view></picker><view wx:elif="{{item.kind==='date' || item.kind==='datetime'}}"><view class="row"><picker mode="date" value="{{dates[item.key] || form[item.key]}}" data-key="{{item.key}}" bindchange="date" class="grow"><view class="picker">{{dates[item.key] || (item.kind==='date' ? form[item.key] : '') || '选择日期'}}</view></picker><picker wx:if="{{item.kind==='datetime'}}" mode="time" value="{{times[item.key] || '09:00'}}" data-key="{{item.key}}" bindchange="time"><view class="picker">{{times[item.key] || '09:00'}}</view></picker></view><text wx:if="{{!item.required && form[item.key]}}" class="link" data-key="{{item.key}}" bindtap="clearDate">清空日期</text></view><textarea wx:elif="{{item.kind==='textarea'}}" value="{{form[item.key] || ''}}" maxlength="{{item.max}}" data-key="{{item.key}}" bindinput="input" placeholder="请输入{{item.label}}"/><input wx:else type="{{item.kind==='number' || item.kind==='digit' ? item.kind : 'text'}}" value="{{form[item.key] === undefined ? '' : form[item.key]}}" maxlength="{{item.max}}" data-key="{{item.key}}" bindinput="input" placeholder="请输入{{item.label}}"/></view></block><view wx:if="{{kind!=='reminder'}}" class="field"><text class="label">照片（最多9张，首张用作封面）</text><view class="photo-grid"><view wx:for="{{form.images}}" wx:key="*this" class="photo-wrap"><image class="photo" src="{{item}}" mode="aspectFill" data-urls="{{form.images}}" data-src="{{item}}" bindtap="preview"/><text class="photo-delete" data-index="{{index}}" bindtap="deleteImage">移除</text></view></view><button wx:if="{{form.images.length < 9}}" class="secondary" style="margin-top:18rpx" bindtap="images" loading="{{uploading}}" disabled="{{uploading}}">添加照片</button></view><view wx:if="{{kind==='reminder'}}" class="hint">到期或提前完成后，按所选周期生成下一次安排。微信通知需在提醒列表中单独订阅。</view><view wx:if="{{kind==='place'}}" class="hint">投稿经人工审核通过后，会出现在友好地图上。</view></view><button class="primary" bindtap="save" loading="{{saving}}" disabled="{{saving || uploading}}">{{kind==='place' ? '提交审核' : '保存'}}</button></block></view>
