<import src="../../templates/state.wxml"/>
<view class="page"><view class="row between"><view class="eyebrow">DOUZHI · PET LIFE</view><text class="muted">每一份陪伴，都值得记录</text></view>
<view class="hero" style="margin-top:24rpx"><image class="hero-image" src="/images/pet.png"/><view class="hero-copy"><view class="title"><view>把小日子，</view><view>过成大幸福。</view></view><view class="subtitle">{{config.announcement || '一起记录毛孩子的成长与日常。'}}</view></view></view>
<template is="state" data="{{loading,error}}"/>
<view class="section"><text class="section-title">{{user ? '家里的小可爱' : '从认识彼此开始'}}</text><text class="link" data-path="pets" bindtap="go">全部宠物 ›</text></view>
<view wx:for="{{pets}}" wx:key="id" class="card row" data-id="{{item.id}}" bindtap="pet"><image class="avatar" src="{{item.cover}}" mode="aspectFill"/><view class="grow"><view class="name">{{item.name}}</view><view class="muted">{{item.typeText}} · {{item.breed || '每一只都独一无二'}}</view></view><text class="link">看档案 ›</text></view>
<view wx:if="{{!pets.length && !loading}}" class="card"><view class="name">给陪伴留一个小小的家</view><view class="muted" style="margin:14rpx 0 26rpx">建立宠物档案，记下它的每一次成长。</view><button class="primary" data-path="{{user ? 'edit/index?kind=pet' : 'login/index'}}" bindtap="go">{{user ? '添加第一只宠物' : '微信登录，开启记录'}}</button></view>
<view class="section"><text class="section-title">今天，也要好好照顾它</text></view>
<view class="grid"><view class="quick" data-path="edit/index?kind=record" bindtap="go"><image src="/images/record-active.png"/><text class="name">记一笔日常</text><text class="muted">喂食 / 洗澡 / 内外驱</text></view><view class="quick" data-path="reminders/index" bindtap="go"><image src="/images/reminder-active.png"/><text class="name">养护小提醒</text><text class="muted">重要的小事，不再忘记</text></view><view class="quick" data-path="map" bindtap="go"><image src="/images/map-active.png"/><text class="name">一起去走走</text><text class="muted">发现身边宠物友好去处</text></view><view class="quick" data-path="consult" bindtap="go"><image src="/images/pets-active.png"/><text class="name">线上问诊</text><text class="muted">宠物健康咨询</text></view></view>
<view wx:if="{{reminders.length}}" class="section"><text class="section-title">接下来的小安排</text><text class="link" data-path="reminders/index" bindtap="go">查看全部 ›</text></view><view wx:for="{{reminders}}" wx:key="id" class="card" data-path="reminders/index" bindtap="go"><view class="name">{{item.title}}</view><view class="muted">{{item.pet_name}} · {{item.timeText}}</view></view></view>
