<import src="../../templates/state.wxml"/><view class="page"><template is="state" data="{{loading,error}}"/><block wx:if="{{item}}"><image class="cover" src="{{item.cover}}" mode="aspectFill"/><text class="tag">{{item.categoryText}}</text><text class="tag green">{{item.source==='official'?'官方收录':item.statusText}}</text><view class="title">{{item.name}}</view><view class="subtitle">{{item.address}}</view><view class="actions"><button class="primary" bindtap="navigate">导航前往</button><button wx:if="{{item.phone}}" class="secondary" bindtap="phone">联系场所</button></view><view class="section"><text class="section-title">出发前，先了解一下</text></view><view class="card"><view class="detail-row"><text class="muted">营业时间</text><text class="value">{{item.hours || '请联系场所确认'}}</text></view><view class="divider"/><view class="name">宠物友好规则</view><view class="note" style="margin-top:16rpx">{{item.rules}}</view><view class="hint">出行前建议联系场所，确认最新接待安排。</view></view><view wx:if="{{item.images.length}}" class="photo-grid"><image wx:for="{{item.images}}" wx:for-item="photo" wx:key="*this" class="photo" src="{{photo}}" mode="aspectFill" data-urls="{{item.images}}" data-src="{{photo}}" bindtap="preview"/></view><view wx:if="{{item.rejection}}" class="error">驳回原因：{{item.rejection}}</view><button wx:if="{{item.status===0 || item.status===2}}" class="secondary" bindtap="edit" style="margin-top:24rpx">编辑并重新提交</button><block wx:if="{{item.status===1}}"><view class="section"><text class="section-title">大家的真实体验</text><text class="muted">{{reviewTotal}} 条评价</text></view><view wx:for="{{reviews}}" wx:key="id" class="card"><view class="row between"><text class="name">{{item.nickname || '豆知朋友'}}</text><view class="review-stars" aria-label="{{item.rating}}星，满分5星"><text wx:for="{{stars}}" wx:for-item="star" wx:key="*this" class="{{star<=item.rating?'star-filled':'star-empty'}}">★</text></view></view><view class="note" style="margin:16rpx 0">{{item.content}}</view><view class="muted">{{item.timeText}}</view></view><view wx:if="{{!reviews.length}}" class="empty">还没有评价，留下你的真实体验吧。</view><button class="primary" bindtap="openReview">去评论</button></block></block></view>
<view wx:if="{{reviewOpen}}" class="review-overlay" catchtouchmove="stopScroll">
  <view class="review-mask" bindtap="closeReview"/>
  <view class="review-dialog" aria-role="dialog" aria-label="分享真实体验">
    <view class="review-heading">分享真实体验<button size="mini" class="review-close" bindtap="closeReview" disabled="{{saving}}" aria-label="关闭评论窗口">×</button></view>
    <scroll-view scroll-y class="review-body"><view class="rating-label">体验评分</view><view class="rating-picker"><button wx:for="{{stars}}" wx:for-item="star" wx:key="*this" class="rating-star {{star<=rating?'star-filled':'star-empty'}}" data-rating="{{star}}" bindtap="rate" aria-label="评为{{star}}星" aria-role="button">★</button><text class="rating-value">{{rating}} 星</text></view><textarea fixed="{{true}}" style="margin-top:20rpx" maxlength="1000" value="{{content}}" bindinput="input" placeholder="带宠物来过这里吗？分享你的真实体验。"/><button class="primary" style="margin-top:20rpx" bindtap="review" loading="{{saving}}" disabled="{{saving}}">提交评价</button></scroll-view>
  </view>
</view>
