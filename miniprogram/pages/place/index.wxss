.review-stars{display:flex;gap:4rpx;font-size:32rpx;flex-shrink:0}.star-filled{color:#dc963b}.star-empty{color:#d8cec4}.rating-label{font-size:28rpx;color:#654837}.rating-picker{display:flex;align-items:center;margin-top:12rpx}.rating-star{margin:0;padding:0;flex:1;min-width:0;width:auto;height:88rpx;line-height:88rpx;font-size:58rpx;background:transparent;border:0}.rating-star::after{border:0}.rating-value{margin-left:12rpx;flex-shrink:0;white-space:nowrap;color:#806e60;font-size:26rpx}

.review-overlay{position:fixed;inset:0;z-index:100}.review-mask{position:absolute;inset:0;background:rgba(45,32,24,.45)}.review-dialog{position:absolute;left:0;right:0;bottom:0;background:#fffdf9;border-radius:32rpx 32rpx 0 0;padding:28rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));box-sizing:border-box}.review-heading{position:relative;line-height:72rpx;font-size:34rpx;font-weight:600;padding-right:80rpx;margin-bottom:16rpx}.review-close{position:absolute;right:0;top:0;margin:0;padding:0;width:72rpx;height:72rpx;line-height:68rpx;font-size:48rpx;background:transparent;color:#806e60}.review-close::after{border:0}.review-body{max-height:65vh}.review-body textarea{box-sizing:border-box;width:100%}
