<import src="../../templates/state.wxml"/><view class="page"><view class="eyebrow">CARE, ON TIME</view><view class="title">小事记在心上</view><view class="row between"><text class="subtitle">让每一份关心，都刚刚好。</text><text class="link" bindtap="add">＋ 新提醒</text></view><view class="chips"><text class="chip {{status==='pending'?'active':''}}" data-status="pending" bindtap="filter">待提醒</text><text class="chip {{status==='done'?'active':''}}" data-status="done" bindtap="filter">已完成</text><text class="chip {{status==='expired'?'active':''}}" data-status="expired" bindtap="filter">已过期</text><text class="chip {{status===''?'active':''}}" data-status="" bindtap="filter">全部</text></view><template is="state" data="{{loading,error}}"/><view wx:for="{{list}}" wx:key="id" class="card"><view class="row between"><view class="name">{{item.title}}</view><text class="tag {{item.status===1?'green':item.overdue?'red':''}}">{{item.status===1?'已完成':!item.enabled?'已关闭':item.overdue?'已过期':'待提醒'}}</text></view><view class="muted">{{item.pet_name}} · {{item.typeText}} · {{item.cycleText}}</view><view style="margin-top:16rpx">{{item.timeText}}</view><view class="hint">提前 {{item.advance_days}} 天 · {{item.subscribed?'本次微信通知已订阅':'站内提醒'}}</view><view class="actions" wx:if="{{item.status!==1}}"><button class="primary" data-id="{{item.id}}" data-action="complete" bindtap="action">标记完成</button><button wx:if="{{!item.next_id}}" class="secondary" data-id="{{item.id}}" bindtap="edit">编辑</button><button wx:if="{{!item.next_id}}" class="ghost" data-id="{{item.id}}" data-action="toggle" bindtap="action">{{item.enabled?'关闭':'开启'}}</button></view><view class="row between" style="margin-top:18rpx"><text wx:if="{{template && item.status!==1 && !item.sent_at}}" class="link" data-id="{{item.id}}" bindtap="subscribe">订阅本次微信通知</text><text class="link" data-id="{{item.id}}" data-action="remove" bindtap="action">删除</text></view></view><view wx:if="{{!list.length && !loading}}" class="empty"><image src="/images/reminder-active.png"/>这里暂时没有提醒<button class="secondary" bindtap="add">安排一件小事</button></view></view>
